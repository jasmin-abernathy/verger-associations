# Générer une valeur longue et aléatoire, différente pour chaque déploiement.
VERGER_SYNC_TOKEN=change-me-with-a-random-secret-of-at-least-24-characters

# Laisser true derrière HTTPS. Mettre false uniquement pour un test HTTP local.
VERGER_COOKIE_SECURE=true

# Origines front autorisées pour les requêtes mutantes, séparées par des virgules.
# Exemple Codespaces :
# VERGER_ALLOWED_ORIGINS=https://votre-codespace-5174.app.github.dev
VERGER_ALLOWED_ORIGINS=

# Origine de la WebView Capacitor Android configurée dans capacitor.config.json.
VERGER_NATIVE_ORIGINS=https://localhost
